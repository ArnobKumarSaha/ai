{
  "model": "sonnet",
  "effortLevel": "medium",

  "enabledMcpjsonServers": [
    "github",
    "kubernetes",
    "fetch"
  ],

  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "gopls-lsp@claude-plugins-official": true
  },

  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    }
  },

  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(*)"
    ],
    "deny": [
      "Bash(sudo *)",

      "Bash(rm -rf *)",
      "Bash(rmdir *)",
      "Bash(shred *)",
      "Bash(dd *)",
      "Bash(mv *)",
      "Bash(truncate *)",
      "Bash(chmod *)",
      "Bash(chown *)",

      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(iptables *)",
      "Bash(ufw *)",

      "Bash(kubectl delete *)",
      "Bash(helm uninstall *)",
      "Bash(helm delete *)",

      "Bash(flux delete *)",
      "Bash(flux suspend *)",

      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(docker stop *)",
      "Bash(docker kill *)",

      "Bash(brew uninstall *)",
      "Bash(brew upgrade *)"
    ]
  }
}
